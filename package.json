{
  "name": "dsh-auto-wake",
  "version": "0.1.0",
  "description": "会话自动唤醒：给任意会话设一条唤醒规则，宿主轮询其最新一轮状态并在满足条件时通过 sessionController.prompt 真正叫醒它继续干活。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "auto-wake",
    "session",
    "scheduler",
    "automation"
  ],
  "license": "MIT",
  "author": "lzlrt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzlrt/dsh-auto-wake.git"
  },
  "homepage": "https://github.com/lzlrt/dsh-auto-wake#readme",
  "bugs": {
    "url": "https://github.com/lzlrt/dsh-auto-wake/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=18"
  }
}
